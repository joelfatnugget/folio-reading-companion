# Choose your default server-side LLM provider: openai | gemini | ollama
LLM_PROVIDER=openai

# OpenAI or OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional PostgreSQL / Supabase connection (app also works local-first via IndexedDB/localStorage)
DATABASE_URL=
